extends GdUnitTestSuite
const Core = preload("res://scripts/inventory/inventory_core012.gd")
const Ground = preload("res://scripts/inventory/inventory_ground012.gd")
const Address = preload("res://scripts/world/spatial_address.gd")
const WORLD := "world_11111111111111111111111111111111"
const PLAYER := "player_ground_fixture"
var core: RefCounted
var layer: Dictionary
func before_test() -> void:
	core = Core.new(WORLD)
	assert_bool(core.trusted_create_player(PLAYER)["ok"]).is_true()
	layer = Address.layer(WORLD, "body_fixture", "surface", 0)
func _seed_fixture(n: int, slot: int = 0) -> void:
	var value: Dictionary = core.snapshot()
	value["players"][PLAYER]["hotbar"][slot] = {"content_id": "mucai", "quantity": n, "item_instance_id": "", "protected_instance_id": "", "state": {}}
	assert_bool(core.trusted_restore(value)["ok"]).is_true()
func drop(sequence: int, slot: int = 0, now: float = 0.0, target: Vector2 = Vector2(3, 0)) -> Dictionary:
	return Ground.prepare_drop(core, PLAYER, "q_one", {"container": "hotbar", "owner": PLAYER, "slot": slot}, core.revision(), sequence, layer, Vector2.ZERO, target, now)
func commit(result: Dictionary) -> void:
	assert_bool(result["ok"]).is_true()
	assert_bool(core.trusted_restore(result["state"])["ok"]).is_true()
func test_first_drop_atomically_extends_old_component_and_keeps_total() -> void:
	_seed_fixture(7)
	var before: PackedByteArray = var_to_bytes(core.snapshot())
	var result: Dictionary = drop(1)
	assert_bool(result["ok"]).is_true()
	assert_bool(var_to_bytes(core.snapshot()) == before).is_true()
	assert_int(result["state"]["schema_version"]).is_equal(2)
	assert_int(result["state"]["players"][PLAYER]["hotbar"][0]["quantity"]).is_equal(6)
	assert_int(result["state"]["ground"].values()[0]["stack"]["quantity"]).is_equal(1)
func test_trajectory_moves_for_half_second_without_teleport() -> void:
	_seed_fixture(7)
	commit(drop(1))
	assert_float(core.snapshot()["ground"].values()[0]["position"][0]).is_equal(0.0)
	commit(Ground.advance(core, 0.25))
	assert_float(core.snapshot()["ground"].values()[0]["position"][0]).is_equal(1.5)
	commit(Ground.advance(core, 0.5))
	assert_float(core.snapshot()["ground"].values()[0]["position"][0]).is_equal(3.0)
func test_exact_snapshot_roundtrip_preserves_remaining_timers_and_carry() -> void:
	_seed_fixture(7)
	commit(drop(1))
	assert_bool(core.click_slot(PLAYER, {"container": "hotbar", "owner": PLAYER, "slot": 0}, core.revision(), 2)["ok"]).is_true()
	commit(Ground.advance(core, 0.25))
	var restored := Core.new(WORLD)
	assert_bool(restored.decode_snapshot(core.encode_snapshot()["bytes"])["ok"]).is_true()
	assert_bool(var_to_bytes(core.snapshot()) == var_to_bytes(restored.snapshot())).is_true()
	assert_int(restored.snapshot()["players"][PLAYER]["carry"]["quantity"]).is_equal(6)
func test_merge_retains_individual_lifetime_and_thrower_delay_cohorts() -> void:
	_seed_fixture(7)
	commit(drop(1, 0, 0.0, Vector2.ZERO))
	commit(Ground.advance(core, 1.0))
	commit(drop(2, 0, 1.0, Vector2.ZERO))
	commit(Ground.advance(core, 1.5))
	var records: Array = core.snapshot()["ground"].values()
	assert_int(records.size()).is_equal(1)
	assert_int(records[0]["stack"]["quantity"]).is_equal(2)
	assert_float(records[0]["lots"][0]["remaining_lifetime"]).is_equal(298.5)
	assert_float(records[0]["lots"][1]["remaining_lifetime"]).is_equal(299.5)
	assert_float(records[0]["lots"][1]["remaining_thrower_protection"]).is_equal(1.0)
func test_expiry_removes_only_elapsed_cohort_not_newer_loot() -> void:
	_seed_fixture(7)
	commit(drop(1, 0, 0.0, Vector2.ZERO))
	commit(Ground.advance(core, 1.0))
	commit(drop(2, 0, 1.0, Vector2.ZERO))
	commit(Ground.advance(core, 300.0))
	var records: Array = core.snapshot()["ground"].values()
	assert_int(records.size()).is_equal(1)
	assert_int(records[0]["stack"]["quantity"]).is_equal(1)
	assert_float(records[0]["lots"][0]["remaining_lifetime"]).is_equal(1.0)
func test_clock_pause_changes_no_timers_and_regression_rejects() -> void:
	_seed_fixture(7)
	commit(drop(1))
	var before: PackedByteArray = var_to_bytes(core.snapshot())
	var same: Dictionary = Ground.advance(core, 0.0)
	assert_bool(var_to_bytes(same["state"]) == before).is_true()
	commit(Ground.advance(core, 0.5))
	assert_bool(Ground.advance(core, 0.25)["ok"]).is_false()
func test_replayed_drop_sequence_is_atomic_rejection() -> void:
	_seed_fixture(7)
	commit(drop(1))
	var before: PackedByteArray = var_to_bytes(core.snapshot())
	assert_bool(drop(1)["ok"]).is_false()
	assert_bool(var_to_bytes(core.snapshot()) == before).is_true()
func test_q_bag_chest_and_foreign_owner_leave_existing_ground_and_cursors_exact() -> void:
	_seed_fixture(7)
	commit(drop(1))
	assert_bool(core.trusted_create_chest("chest_ground_fixture")["ok"]).is_true()
	var value: Dictionary = core.snapshot()
	value["players"][PLAYER]["bag"][0] = value["players"][PLAYER]["hotbar"][0].duplicate(true)
	value["chests"]["chest_ground_fixture"]["slots"][0] = value["players"][PLAYER]["hotbar"][0].duplicate(true)
	assert_bool(core.trusted_restore(value)["ok"]).is_true()
	assert_bool(core.trusted_set_chest_access(PLAYER, "chest_ground_fixture", true)["ok"]).is_true()
	var before: PackedByteArray = var_to_bytes(core.snapshot())
	for source in [{"container": "bag", "owner": PLAYER, "slot": 0}, {"container": "chest", "owner": "chest_ground_fixture", "slot": 0}, {"container": "hotbar", "owner": "player_other", "slot": 0}]:
		var result: Dictionary = Ground.prepare_drop(core, PLAYER, "q_one", source, core.revision(), 2, layer, Vector2.ZERO, Vector2(3, 0), 0.0)
		assert_bool(result["ok"]).is_false()
		assert_str(result["code"]).is_equal("INVENTORY_ADDRESS_INVALID" if source["owner"] == "player_other" else "DROP_Q_HOTBAR_REQUIRED")
		assert_bool(var_to_bytes(core.snapshot()) == before).is_true()
func test_ground_and_inventory_duplicate_instance_rejected() -> void:
	_seed_fixture(1)
	commit(drop(1))
	var value: Dictionary = core.snapshot()
	var gun := {"content_id": "wuqi_huoqi_tansuo_01", "quantity": 1, "item_instance_id": "item_shared", "protected_instance_id": "protected_shared", "state": {"ammo": 3}}
	value["ground"].values()[0]["stack"] = gun.duplicate(true)
	value["players"][PLAYER]["bag"][0] = gun.duplicate(true)
	assert_bool(core.validate_snapshot(value)["ok"]).is_false()
func test_old_whole_component_plan_cannot_overwrite_new_clock() -> void:
	_seed_fixture(7)
	commit(drop(1))
	var old: Dictionary = drop(2)
	assert_bool(old["ok"]).is_true()
	commit(Ground.advance(core, 0.25))
	var Owner = load("res://scripts/inventory/inventory_owner012.gd")
	var owner: RefCounted = Owner.new(null, null)
	owner._core = core # Isolated CAS seam; not a ready production owner.
	assert_str(owner._publish_checked({}, core, old)["code"]).is_equal("INVENTORY_WHOLE_STATE_STALE")
func test_invalid_core_and_oversized_lot_reject() -> void:
	assert_bool(Ground.advance(null, 0.0)["ok"]).is_false()
	_seed_fixture(7)
	commit(drop(1))
	var value: Dictionary = core.snapshot()
	value["ground"].values()[0]["lots"][0]["quantity"] = 9223372036854775807
	assert_bool(core.validate_snapshot(value)["ok"]).is_false()
func test_thrower_waits_extra_second_while_other_player_can_pickup() -> void:
	_seed_fixture(7)
	assert_bool(core.trusted_create_player("player_other")["ok"]).is_true()
	commit(drop(1, 0, 0.0, Vector2.ZERO))
	commit(Ground.advance(core, 0.5))
	var blocked: Dictionary = Ground.pickup(core, {PLAYER: {"layer": layer, "position": [0.0, 0.0]}}, 0.1, 3.0, 8.0)
	assert_int(blocked["state"]["ground"].size()).is_equal(1)
	var taken: Dictionary = Ground.pickup(core, {"player_other": {"layer": layer, "position": [0.0, 0.0]}}, 0.1, 3.0, 8.0)
	assert_bool(taken["ok"]).is_true()
	assert_int(taken["state"]["ground"].size()).is_equal(0)
	assert_int(taken["state"]["players"]["player_other"]["hotbar"][0]["quantity"]).is_equal(1)
func test_attraction_moves_before_atomic_arrival_and_preserves_that_position() -> void:
	_seed_fixture(7)
	commit(drop(1, 0, 0.0, Vector2.ZERO))
	commit(Ground.advance(core, 1.5))
	var active := {PLAYER: {"layer": layer, "position": [2.0, 0.0]}}
	commit(Ground.pickup(core, active, 0.1, 3.0, 8.0))
	assert_float(core.snapshot()["ground"].values()[0]["position"][0]).is_equal_approx(0.8, 0.000001)
	assert_int(core.snapshot()["players"][PLAYER]["hotbar"][0]["quantity"]).is_equal(6)
	commit(Ground.advance(core, 1.6))
	assert_float(core.snapshot()["ground"].values()[0]["position"][0]).is_equal_approx(0.8, 0.000001)
	commit(Ground.pickup(core, active, 0.2, 3.0, 8.0))
	assert_bool(core.snapshot()["ground"].is_empty()).is_true()
	assert_int(core.snapshot()["players"][PLAYER]["hotbar"][0]["quantity"]).is_equal(7)
func test_mixed_cohort_does_not_pick_protected_new_quantity_with_old_stack() -> void:
	_seed_fixture(7)
	commit(drop(1, 0, 0.0, Vector2.ZERO))
	commit(Ground.advance(core, 1.0))
	commit(drop(2, 0, 1.0, Vector2.ZERO))
	commit(Ground.advance(core, 1.5))
	commit(Ground.pickup(core, {PLAYER: {"layer": layer, "position": [0.0, 0.0]}}, 0.1, 3.0, 8.0))
	assert_int(core.snapshot()["players"][PLAYER]["hotbar"][0]["quantity"]).is_equal(6)
	assert_int(core.snapshot()["ground"].values()[0]["stack"]["quantity"]).is_equal(1)
	assert_float(core.snapshot()["ground"].values()[0]["lots"][0]["remaining_thrower_protection"]).is_equal(1.0)
func test_pickup_tie_breaks_by_stable_player_identity() -> void:
	_seed_fixture(7)
	core.trusted_create_player("player_a")
	core.trusted_create_player("player_z")
	commit(drop(1, 0, 0.0, Vector2.ZERO))
	commit(Ground.advance(core, 0.5))
	commit(Ground.pickup(core, {"player_z": {"layer": layer, "position": [0.0, 0.0]}, "player_a": {"layer": layer, "position": [0.0, 0.0]}}, 0.1, 3.0, 8.0))
	assert_that(core.snapshot()["players"]["player_z"]["hotbar"][0]).is_null()
	assert_int(core.snapshot()["players"]["player_a"]["hotbar"][0]["quantity"]).is_equal(1)
func test_full_inventory_leaves_world_quantity_intact() -> void:
	_seed_fixture(7)
	commit(drop(1, 0, 0.0, Vector2.ZERO))
	commit(Ground.advance(core, 1.5))
	var value: Dictionary = core.snapshot()
	for kind in ["bag", "hotbar"]:
		for i in range(value["players"][PLAYER][kind].size()): value["players"][PLAYER][kind][i] = {"content_id": "shitou", "quantity": 999, "item_instance_id": "", "protected_instance_id": "", "state": {}}
	core.trusted_restore(value)
	commit(Ground.pickup(core, {PLAYER: {"layer": layer, "position": [0.0, 0.0]}}, 0.1, 3.0, 8.0))
	assert_int(core.snapshot()["ground"].values()[0]["stack"]["quantity"]).is_equal(1)
