@@ -13,0 +14,25 @@
+# The route model coordinates only refundable P3 rank-change conversions.
+# Kill growth stays in the original source hook and is never journalled here.
+var _p3_bound_model:WeakRef
+var _p3_projection_owner:WeakRef
+var _p3_projection_events:Array=[]
+func set_progression(ledger:RefCounted)->void:
+ var model:Variant=ledger.get("model")
+ if model!=null and model.has_method("bind_p3_sim"):
+  var bound:Dictionary=model.bind_p3_sim(self)
+  if not bound.accepted:
+   push_error("P3 progression binding failed: "+str(bound.reason))
+   return
+  _p3_bound_model=weakref(model)
+ super.set_progression(ledger)
+func begin_p3_growth_projection(owner:RefCounted)->bool:
+ if _p3_bound_model==null or not is_same(_p3_bound_model.get_ref(),owner) or _p3_projection_owner!=null or transaction_active:return false
+ _p3_projection_owner=weakref(owner)
+ _p3_projection_events.clear()
+ return true
+func end_p3_growth_projection(owner:RefCounted)->Array:
+ assert(_p3_projection_owner!=null and is_same(_p3_projection_owner.get_ref(),owner))
+ var events:Array=_p3_projection_events.duplicate(true)
+ _p3_projection_events.clear()
+ _p3_projection_owner=null
+ return events
@@ -584 +609,6 @@
- emit_event("permanent_attack_gained",{"cast_id":cast_id,"source":source,"amount":gains*v("P3-2",rank),"total":hero.permanent_ad,"kills":hero.credited_kills,"remaining_kills":hero.p3_progress})
+ var event:Dictionary={"cast_id":cast_id,"source":source,"amount":gains*v("P3-2",rank),"total":hero.permanent_ad,"kills":hero.credited_kills,"remaining_kills":hero.p3_progress}
+ if _p3_projection_owner!=null and source=="p3_rank_change":
+  # Publish only after the same command has its SP/rank/growth journal and receipt.
+  _p3_projection_events.append(event)
+ else:
+  emit_event("permanent_attack_gained",event)
