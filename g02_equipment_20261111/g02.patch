+## Adapted from the existing 2026-10-09 G02 original-death bridge. Fengli has no
+## Yan P1 atomic branch. Its real G11 execute instead has a separate drain witness.
+var _source:WeakRef
+var _damage:Array=[]
+var _deaths:Array=[]
+var _emissions:Array=[]
+var _executions:Array=[]
+var _serial:int=0
+
+func _init(source:Node)->void:_source=weakref(source)
+func sim():return _source.get_ref()
+
+func target_current(enemy:Dictionary,committed:bool=false)->bool:
+ var s=sim()
+ return is_instance_valid(s) and s.phase=="combat" and (committed or not s.paused) and not s.hero.dead and not enemy.is_empty() and is_same(enemy,s.enemy_by_id(str(enemy.get("actor_id","")))) and enemy.get("generation") is int and int(enemy.generation)==s.encounter_generation and str(enemy.get("room_id",""))==s.room_id and enemy.get("rank_category") in ["ordinary","elite","boss"]
+
+func begin_damage(enemy:Dictionary,source:String,cast_id:int)->Dictionary:
+ var s=sim()
+ var frame:Dictionary={"enemy":enemy,"source":source,"cast_id":cast_id,"hero":s.hero,"generation":s.encounter_generation,"room_id":s.room_id,"pre_hp":float(enemy.get("hp",0.0)),"expected_hp":float(enemy.get("hp",0.0)),"pre_dead":bool(enemy.get("dead",true)),"seen":false,"damage":{}}
+ _damage.append(frame)
+ return frame
+
+func end_damage(frame:Dictionary)->void:
+ if _damage.is_empty() or not is_same(_damage.back(),frame):return
+ _damage.pop_back()
+ var loss:float=float(frame.pre_hp)-float(frame.enemy.get("hp",0.0))
+ # Propagate a nested child subtree once, to its immediate matching ancestor.
+ for index:int in range(_damage.size()-1,-1,-1):
+  var parent:Dictionary=_damage[index]
+  if is_same(parent.enemy,frame.enemy) and parent.generation==frame.generation and parent.room_id==frame.room_id:
+   if not parent.seen:parent.expected_hp=float(parent.expected_hp)-loss
+   break
+
+func note_damage(data:Dictionary)->void:
+ if _damage.is_empty():return
+ var s=sim()
+ var frame:Dictionary=_damage.back()
+ if not is_same(frame.hero,s.hero) or frame.seen or frame.generation!=s.encounter_generation or frame.room_id!=s.room_id:return
+ var enemy:Dictionary=frame.enemy
+ if not target_current(enemy) or frame.pre_dead or enemy.dead:return
+ if data.get("target")!=enemy.actor_id or data.get("source")!=frame.source or not data.get("cast_id") is int or data.cast_id!=frame.cast_id:return
+ var amount:Variant=data.get("amount")
+ if not (amount is int or amount is float) or not is_finite(float(amount)) or float(amount)<=0.0:return
+ var before:float=frame.expected_hp
+ var after:float=enemy.hp
+ var loss:float=before-after
+ var roundoff:float=maxf(0.000000001,absf(before)*0.0000000000000008881784197001252)
+ if not is_finite(before) or not is_finite(after) or before<=0.0 or after<0.0 or loss<=0.0 or float(amount)>before or absf(loss-float(amount))>roundoff:return
+ frame.seen=true
+ frame.damage={"hp_before":before,"hp_after":after,"amount":float(amount)}
+
+func begin_execute(bridge:RefCounted,event:Dictionary)->Dictionary:
+ var s=sim()
+ var frame:Dictionary={}
+ if is_same(s.common,bridge) and bridge.original_execute_is_current(event) and event.get("source")=="common_g11" and event.get("cast_id") is int:
+  var enemy:Dictionary=s.enemy_by_id(str(event.get("target_id","")))
+  if target_current(enemy) and not enemy.dead and float(enemy.hp)>0.0 and s.ordinary(enemy) and s.cast_is_current(int(event.cast_id)):
+   frame={"enemy":enemy,"source":"common_g11","cast_id":int(event.cast_id),"hero":s.hero,"generation":s.encounter_generation,"room_id":s.room_id,"bridge":bridge,"event":event,"hp_before":float(enemy.hp)}
+ _executions.append(frame) # Invalid nested calls shadow rather than borrow.
+ return frame
+
+func end_execute(frame:Dictionary)->void:
+ if not _executions.is_empty() and is_same(_executions.back(),frame):_executions.pop_back()
+
+func begin_death(enemy:Dictionary,source:String,cast_id:int)->Dictionary:
+ var s=sim()
+ var frame:Dictionary={}
+ var proof:String=""
+ var origin:Dictionary={}
+ if target_current(enemy,true) and not enemy.dead and s.cast_is_current(cast_id):
+  if float(enemy.hp)==0.0 and not _damage.is_empty():
+   var damage:Dictionary=_damage.back()
+   if is_same(damage.hero,s.hero) and is_same(damage.enemy,enemy) and damage.source==source and damage.cast_id==cast_id and damage.generation==s.encounter_generation and damage.room_id==s.room_id and damage.seen and damage.damage.get("hp_after") == 0.0 and float(damage.damage.get("amount",0.0))>0.0:
+    proof="original_damage_death";origin=damage
+  elif source=="common_g11" and not _executions.is_empty():
+   var execute:Dictionary=_executions.back()
+   if not execute.is_empty() and is_same(execute.hero,s.hero) and is_same(execute.enemy,enemy) and execute.cast_id==cast_id and execute.generation==s.encounter_generation and execute.room_id==s.room_id and float(enemy.hp)==float(execute.hp_before) and execute.bridge.original_execute_is_current(execute.event):
+    proof="original_common_execute_death";origin=execute
+  if not proof.is_empty():
+   _serial+=1
+   frame={"enemy":enemy,"source":source,"cast_id":cast_id,"proof":proof,"origin":origin,"hero":s.hero,"generation":s.encounter_generation,"room_id":s.room_id,"rank_category":enemy.rank_category,"death_serial":_serial,"hero_depth":0,"hero_returned":false,"emitted":false,"invalid":false}
+ _deaths.append(frame)
+ return frame
+
+func end_death(frame:Dictionary)->void:
+ if not _deaths.is_empty() and is_same(_deaths.back(),frame):_deaths.pop_back()
+
+func current(frame:Dictionary)->bool:
+ var s=sim()
+ if frame.is_empty() or frame.invalid or not is_same(frame.hero,s.hero) or frame.generation!=s.encounter_generation or frame.room_id!=s.room_id:return false
+ var enemy:Dictionary=frame.enemy
+ if not target_current(enemy,true) or not enemy.dead or float(enemy.hp)!=0.0 or enemy.rank_category!=frame.rank_category:return false
+ if _deaths.is_empty() or not is_same(_deaths.back(),frame):return false
+ if frame.proof=="original_damage_death":return not _damage.is_empty() and is_same(_damage.back(),frame.origin)
+ return frame.proof=="original_common_execute_death" and not _executions.is_empty() and is_same(_executions.back(),frame.origin) and frame.origin.bridge.original_execute_is_current(frame.origin.event)
+
+func matching(enemy:Dictionary,source:String,cast_id:int)->Dictionary:
+ if _deaths.is_empty():return {}
+ var frame:Dictionary=_deaths.back()
+ return frame if not frame.is_empty() and is_same(frame.enemy,enemy) and frame.source==source and frame.cast_id==cast_id and current(frame) else {}
+
+func begin_hero_killed(enemy:Dictionary,source:String,cast_id:int)->Dictionary:
+ var frame:Dictionary=matching(enemy,source,cast_id)
+ if not frame.is_empty():frame.hero_depth+=1
+ return frame
+
+func end_hero_killed(frame:Dictionary)->void:
+ if frame.is_empty():return
+ frame.hero_depth-=1
+ if frame.hero_depth==0 and current(frame):frame.hero_returned=true
+
+func begin_emission(data:Dictionary)->Dictionary:
+ var s=sim()
+ var emission:Dictionary={}
+ if data.get("credit")=="solo_lethal" and data.get("cast_id") is int:
+  var enemy:Dictionary=s.enemy_by_id(str(data.get("target","")))
+  var frame:Dictionary=matching(enemy,str(data.get("source","")),int(data.cast_id))
+  if not frame.is_empty() and not frame.emitted and frame.hero_returned and frame.hero_depth==0:
+   var expected:Dictionary={"target":enemy.actor_id,"position":enemy.position,"source":frame.source,"cast_id":frame.cast_id,"credit":"solo_lethal","enemy_kind":enemy.kind}
+   if data==expected:
+    frame.emitted=true
+    emission={"frame":frame,"raw":data.duplicate(true),"sequence":-1}
+ _emissions.append(emission)
+ return emission
+
+func end_emission(emission:Dictionary)->void:
+ if not _emissions.is_empty() and is_same(_emissions.back(),emission):_emissions.pop_back()
+
+func verify(owner:RefCounted,event:Dictionary,run_id:String)->Dictionary:
+ var s=sim()
+ if not s.g02_model_is_bound(owner) or run_id.is_empty() or str(owner._run_id)!=run_id or event.get("kind")!="kill" or _emissions.is_empty():return {}
+ var emission:Dictionary=_emissions.back()
+ if emission.is_empty():return {}
+ var frame:Dictionary=emission.frame
+ if not current(frame) or not frame.emitted:return {}
+ for key:String in emission.raw:
+  if event.get(key)!=emission.raw[key]:return {}
+ if event.get("generation")!=frame.generation or event.get("room_id")!=frame.room_id or not event.get("sequence") is int:return {}
+ if int(emission.sequence)>=0 and emission.sequence!=event.sequence:return {}
+ var observed:bool=false
+ for recorded:Dictionary in s.event_log:
+  if recorded.get("sequence")==event.sequence and recorded==event:observed=true;break
+ if not observed:return {}
+ emission.sequence=int(event.sequence)
+ var enemy:Dictionary=frame.enemy
+ var scope:Dictionary={"run_id":run_id,"actor_id":owner.state.actor_id,"generation":s.encounter_generation,"room_id":s.room_id}
+ var witness:Dictionary={"scope":scope,"proof":frame.proof,"death_serial":frame.death_serial,"target":enemy.actor_id,"rank_category":frame.rank_category,"source":frame.source,"cast_id":frame.cast_id,"source_bridge_connected":true,"original_target_identity_verified":true,"original_death_commit_verified":true,"hero_killed_return_verified":true,"first_kill_emission_verified":true,"current_scope_verified":true,"bound_owner_verified":true}
+ var target:Dictionary={"actor_id":enemy.actor_id,"rank_category":frame.rank_category,"generation":frame.generation,"room_id":frame.room_id,"dead":enemy.dead,"hp":enemy.hp}
+ return {"schema":"g02_verified_own_death_v1","event":event.duplicate(true),"original_target":target,"witness":witness}
+
+func invalidate()->void:
+ for frame:Dictionary in _deaths:
+  if not frame.is_empty():frame.invalid=true
+ _damage.clear();_deaths.clear();_emissions.clear();_executions.clear()
