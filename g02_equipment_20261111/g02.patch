+extends "res://scripts/combat/common_hex_bridge.gd"
+## Original effect drain, with a short-lived identity for its actual G11 entry.
+## No Common rule, queue, RNG, cost, hit, damage or recursion limit is changed.
+var _g02_drained_event:Dictionary={}
+
+func drain()->void:
+ if _draining or _inside_hit>0:return
+ _draining=true
+ var count=0
+ while true:
+  var batch=runtime.drain_events()
+  if batch.is_empty():break
+  for event in batch:
+   count+=1
+   if count>MAX_DRAIN:
+    push_error("Common Hex effect drain exceeded bounded work budget")
+    _g02_drained_event={};_draining=false
+    return
+   if int(event.generation)!=sim().encounter_generation or event.room_id!=sim().room_id:continue
+   _g02_drained_event=event
+   _apply(event)
+   _g02_drained_event={}
+ _draining=false
+
+func original_execute_is_current(event:Dictionary)->bool:
+ var s=sim()
+ return _draining and not _g02_drained_event.is_empty() and is_same(_g02_drained_event,event) and event.get("kind")=="execute" and event.get("source")=="common_g11" and event.get("generation")==s.encounter_generation and event.get("room_id")==s.room_id and runtime.active("g11") and runtime.executed.has(str(event.get("target_id","")))
+
+func _apply(event:Dictionary)->void:
+ if event.get("kind")!="execute":super._apply(event);return
+ var frame:Dictionary=sim()._g02_witness.begin_execute(self,event)
+ super._apply(event)
+ sim()._g02_witness.end_execute(frame)
