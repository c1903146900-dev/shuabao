+ var desired: int = int(owner.state.skills.P.rank) if owner.state.skills.P.candidate == "P3" else 0
+ if frame.action == "undo_skill" and int(frame.get("transaction",0)) > 0:
+  return ink_p3.undo_upgrade(int(frame.transaction),hero.cooldowns)
+ if desired == ink_p3.rank: return {"accepted":true,"changed":false}
+ if desired == 0:
+  ink_p3.reset(0)
+  return {"accepted":true,"changed":true}
+ return ink_p3.upgrade(desired,hero.cooldowns)
