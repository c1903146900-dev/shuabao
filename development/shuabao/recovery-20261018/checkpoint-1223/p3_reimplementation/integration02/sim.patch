+ var identity: String = JSON.stringify([frame.run_id,frame.generation,frame.room_id,family,frame.cast_id])
+ var result: Dictionary = ink_p3.release(family.left(1),identity,hero.cooldowns)
+ if not result.get("accepted",false): return
+ result.merge({"family":family,"cast_id":frame.cast_id,"run_id":frame.run_id,"generation":frame.generation,"room_id":frame.room_id,"source_time":hero_time})
+ ink_p3_receipts.append(result.duplicate(true))
