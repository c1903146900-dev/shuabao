+func complete_entered_training(row: int, entered: Dictionary) -> Dictionary:
+ await process_frame
+ var inspection: Dictionary=driver.inspect_and_skip_original_training(row)
+ if not inspection.get("accepted",false):return inspection
+ var completion: Dictionary=driver.complete_original_service()
+ await process_frame
+ var after: Dictionary=observe()
+ var record: Dictionary={"row":row,"entry":entered.duplicate(true),"inspection":inspection,"completion":completion,"after":after}
+ service_records.append(record)
+ save_json("row%d_original_training.json"%row,record)
+ if not completion.get("accepted",false):return completion
+ var rows: Array=after.flow.row_state.get("completed_rows",[])
+ if rows.size()!=row or rows.back().identity.node_id!=ROUTE_NODES[row-1] or rows.back().entry.payload.service_type!="training":return {"accepted":false,"reason":"original_training_completion_scope_failed"}
+ var before: Dictionary=entered.before_entry
+ for key: String in ["gold","xp","level","points","body"]:
+  if before.model[key]!=after.model_state[key]:return {"accepted":false,"reason":"training_skip_changed_resource:"+key}
+ if absf(float(before.hp)-float(after.hero_hp))>0.001:return {"accepted":false,"reason":"training_skip_changed_HP"}
+ await capture("row%d_original_training_ready"%row,after)
+ return {"accepted":true,"row":row,"paid":false}
+
+func enter_and_complete_training(row: int) -> Dictionary:
+ var entered: Dictionary=await driver.prepare_next_original_node(row,ROUTE_NODES[row-1])
