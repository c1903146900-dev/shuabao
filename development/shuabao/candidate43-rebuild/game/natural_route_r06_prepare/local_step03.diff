+func _choose_visible_local_step(visible: Array, desired: float, preferred: Vector3) -> Vector3:
+ # Ordinary eight-key directions, one visible local step only. No enemy source
+ # state, future trajectories, global route search or source-position writes.
+ var here: Vector3=host.sim.hero.position
+ var chosen: Vector3=Vector3.ZERO
+ var best: float=-INF
+ var candidates: Array=[]
+ for raw: Vector3 in [Vector3.FORWARD,Vector3(1,0,-1),Vector3.RIGHT,Vector3(1,0,1),Vector3.BACK,Vector3(-1,0,1),Vector3.LEFT,Vector3(-1,0,-1)]:
+  var direction: Vector3=raw.normalized()
+  var next: Vector3=here+direction
+  if not _ground_clear(here,next,float(host.sim.hero_radius)) or _visible_ground(next).is_empty():continue
+  var gap: float=INF
+  for enemy: Dictionary in visible:gap=minf(gap,next.distance_to(enemy.position))
+  var openness: int=0
+  for side: Vector3 in [Vector3.FORWARD,Vector3.RIGHT,Vector3.BACK,Vector3.LEFT]:
+   var near: Vector3=next+side
+   if _ground_clear(next,near,float(host.sim.hero_radius)) and not _visible_ground(near).is_empty():openness+=1
+  var score: float=-absf(gap-desired)+float(openness)*0.20+direction.dot(preferred)*0.10
+  candidates.append({"direction":direction,"visible_step":next,"nearest_visible_gap":gap,"open_local_sides":openness,"score":score})
+  if score>best:best=score;chosen=direction
+ visibility_log.back()["local_movement"]={"hero_position":here,"desired_range":desired,"candidates":candidates,"chosen":chosen}
+ return chosen
