+func resolve_visible_required_hexes() -> Dictionary:
+ while not host.shop_session.ledger.model.snapshot().pending_milestones.is_empty():
+  if Time.get_ticks_msec()>=deadline_ms:return {"accepted":false,"reason":"deadline_before_required_hex"}
+  if host.sim.hero.dead or host.finished:return {"accepted":false,"reason":"owner_ended_before_required_hex"}
+  if host._mainprep_required or not host.initial_hud.hex_draft.is_visible_in_tree():
+   await host.get_tree().process_frame;continue
+  var shown: Dictionary=host.initial_hud.projection.duplicate(true)
+  var pending: Array=host.shop_session.ledger.model.snapshot().pending_milestones
+  if shown.get("choices",[]).size()!=4 or int(shown.get("active_milestone",0)) not in pending:
+   await host.get_tree().process_frame;continue
+  release_between_nodes()
+  var choice: Dictionary=shown.choices[1].duplicate(true)
+  var chosen: Dictionary=_hud_request("hex_select",{"milestone":shown.active_milestone,"slot":1})
+  _record("visible_required_hex_choice",choice,chosen)
+  if not chosen.get("accepted",false):return chosen
+  await host.get_tree().process_frame
+ return {"accepted":true,"reason":"original_required_hexes_resolved"}
+
