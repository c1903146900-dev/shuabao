+  var skipped: Dictionary={"accepted":true,"upgraded":false,"reason":"earned_Q1_upgrade_not_available","level":state.level,"SP":state.points,"Q":state.skills.Q.duplicate(true)}
+  _record("optional_earned_Q1_upgrade",{},skipped);return skipped
+ if not host._learning_panel_allowed():return {"accepted":false,"reason":"original_safe_learning_not_allowed"}
+ if not host.initial_hud.growth_panel.is_visible_in_tree():
+  host._toggle_growth()
+  _record("Host:_toggle_growth",{}, {"accepted":host.initial_hud.growth_panel.is_visible_in_tree()})
+ var button: Button=host.initial_hud.q_choices.Q1.upgrade
+ if not button.is_visible_in_tree() or button.disabled:return {"accepted":false,"reason":"original_earned_Q1_button_disabled"}
+ var learned: Dictionary=_hud_request("learn",{"slot_id":"Q","candidate_id":"Q1","expected_rank":1})
