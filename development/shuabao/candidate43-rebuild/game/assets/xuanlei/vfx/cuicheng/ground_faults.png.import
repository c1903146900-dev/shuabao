; Explicit ImageTexture runtime conversion; not editor cache.
[remap]
importer="texture"
type="ImageTexture"
path="res://runtime_converted_assets/hostile_textures/ground_faults.res"
[deps]
source_file="res://assets/xuanlei/vfx/cuicheng/ground_faults.png"
dest_files=["res://runtime_converted_assets/hostile_textures/ground_faults.res"]
[params]
process/fix_alpha_border=true
mipmaps/generate=false
