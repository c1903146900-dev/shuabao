+ for pickup: Dictionary in state.get("pickups", []):
+  # Pickup feedback stays on the floor, away from the hero's face and weapon.
+  # Screen-space decoration only, not a new interaction or damage radius.
+  var at: Vector2 = view.p(pickup.position)
+  if not at.is_finite(): continue
+  var alpha: float = float(pickup.life_fraction)
+  var progress: float = 1.0 - alpha
+  var radius: Vector2 = Vector2(28.0, 10.0).lerp(Vector2(42.0, 15.0), progress)
+  # Four separated curved glints remain visible around a nearby actor silhouette.
+  for quadrant: int in range(4):
+   var arc := PackedVector2Array()
+   for index: int in range(7):
+    var angle: float = float(quadrant) * PI * 0.5 + 0.18 + float(index) * 0.19
+    arc.append(at + Vector2(cos(angle) * radius.x, sin(angle) * radius.y))
+   view.draw_polyline(arc, Color(0.03, 0.12, 0.16, 0.85 * alpha), 4.5, true)
+   view.draw_polyline(arc, Color(0.55, 1.0, 0.79, alpha), 2.5, true)
+
