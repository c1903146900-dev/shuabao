+extends RefCounted
+## UI intent adapter only: one existing Session, wallet, RNG and body ledger.
+## The immutable catalog owns price/outcomes; no new draw, refund or refresh path.
+var _owner:WeakRef
+
+func _init(owner:RefCounted)->void:
+ _owner=weakref(owner)
+
+func _location_reason()->String:
+ var owner:RefCounted=_owner.get_ref()
+ if owner==null:return "session_unavailable"
+ var reason:String=owner.shop_location_reason()
+ if not reason.is_empty():return reason
+ if not owner.panel_open:return "shop_panel_not_open"
+ if not owner.ledger.model.state.shop_visit.get("ui_open",false):return "shop_panel_not_open"
+ if owner.initial_modal_open or not owner.ledger.model.snapshot().pending_milestones.is_empty():return "mandatory_hex_pending"
+ # Do not use _safe_boundary_reason here: a paid pending selection must remain
+ # reachable after closing/reopening this same shop. That guard still blocks exit.
+ return ""
+
+func view()->Dictionary:
+ var owner:RefCounted=_owner.get_ref()
+ if owner==null or owner.ledger==null:return {"ready":false}
+ var model:RefCounted=owner.ledger.model
+ var definition:Dictionary=model.config.get("body",{})
+ var training:Dictionary=model.training_status()
+ var reason:String=_location_reason()
+ var can_select:bool=reason.is_empty() and not training.pending.is_empty()
+ if reason.is_empty():reason=str(training.reason)
+ return {"ready":true,"can_buy":reason.is_empty(),"can_select":can_select,"reason":reason,"cost":int(training.price),"count":int(training.purchase_count),"pending":training.pending.duplicate(true),"outcomes":definition.get("outcomes",{}).duplicate(true),"eligibility":training.eligibility.duplicate(true),"token":training.token.duplicate(true)}
+
+func submit(id:String,action:String,args:Dictionary)->Dictionary:
+ var reason:String=_location_reason()
+ if not reason.is_empty():return _deny(reason)
+ if id.is_empty():return _deny("missing_command_id")
+ var permitted:Array=["epoch","revision","room_id"]
+ if action=="select_body":permitted.append_array(["purchase_id","outcome"])
+ for key in args:
+  if key not in permitted:return _deny("unsupported_training_argument")
+ var owner:RefCounted=_owner.get_ref()
+ var model:RefCounted=owner.ledger.model
+ var arguments:Dictionary={"epoch":args.get("epoch",-1),"revision":args.get("revision",-1),"room_id":args.get("room_id","")}
+ var result:Dictionary
+ if action=="buy_body":
+  # Stable command identity, not a fresh sequence on retries. The real commerce
+  # owner is the only caller allowed to submit pay_body to the existing kernel.
+  arguments["purchase_id"]=owner.run_id+"|body|"+id
+  result=owner.ledger.shop_authority(owner,id,"pay_body",arguments)
+ elif action=="select_body":
+  var runtime_reason:String=owner.ledger._runtime_preflight()
+  if not runtime_reason.is_empty():return _deny(runtime_reason)
+  if not model.receipts.has(id):
+   var token:Dictionary=model.commerce_token()
+   if arguments.epoch!=token.epoch:return _deny("stale_epoch")
+   if arguments.revision!=token.revision:return _deny("stale_revision")
+   if arguments.room_id!=token.room_id:return _deny("stale_room")
+  # Preserve the displayed token in the original receipt request, as in the
+  # existing 2026-10-09 formal-training adapter. Only fresh commits project stats.
+  result=owner.ledger._refresh_committed(model.command(id,"select_body",args.duplicate(true)))
+ else:return _deny("unknown_body_intent")
+ if result.get("accepted",false):owner.growth_dirty=true
+ return result
+
+func _deny(reason:String)->Dictionary:
+ return {"accepted":false,"changed":false,"reason":reason,"events":[]}
