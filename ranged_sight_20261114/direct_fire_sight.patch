+# Direct bolts collide with walls; lobbed pitcher attacks intentionally do not.
+func _clear_shot(sim,enemy:Dictionary,at:Vector3)->bool:
+ var direction:Vector3=at.direction_to(sim.hero.position)
+ var origin:Vector3=at+direction*(float(enemy.radius)+0.18)
+ var radius:float=0.17 if enemy.kind=="support" else 0.14
+ # Include the muzzle segment so an origin beyond a thin wall is not accepted.
+ return _sight_leg(sim,at,origin,radius) and _sight_leg(sim,origin,sim.hero.position,radius)
