      "code": "probe_locked_buy()"
    },
    "expect_text": [
      "true"
    ]
  },
  {
    "server": "godot",
    "tool": "get_game_screenshot",
    "arguments": {}
  },
  {
    "server": "godot",
    "tool": "execute_game_script",
    "arguments": {
      "code": "show_page(1)"
    },
    "expect_text": [
      "1"
    ]
  },
  {
    "server": "godot",
    "tool": "get_game_screenshot",
    "arguments": {}
  },
