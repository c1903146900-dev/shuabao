[
  {
    "server": "godot",
    "tool": "open_scene",
    "arguments": {
      "scene_path": "res://scenes/progression/catalog_review.tscn"
    }
  },
  {
    "server": "godot",
    "tool": "get_scene_tree",
    "arguments": {},
    "expect_text": [
      "Readout"
    ]
  },
  {
    "server": "godot",
    "tool": "play_scene",
    "arguments": {
