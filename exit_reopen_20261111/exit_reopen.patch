+func reopen_exit_map()->Dictionary:
+ # An explicit local re-open after cancel, never a remote route selector.
+ var reason:String=_safe_boundary_reason()
+ if not reason.is_empty():return _deny(reason)
+ if not room_exit_ready():return _deny("complete_current_node_first")
+ if not _at_room_exit():return _deny("walk_to_upper_exit")
+ _exit_cancel_rearm=false
+ update_room_exit()
+ return {"accepted":_exit_permission_current(),"reason":"" if _exit_permission_current() else "walk_to_upper_exit"}
 
