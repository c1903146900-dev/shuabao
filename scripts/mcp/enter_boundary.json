[
  {
    "server": "godot",
    "tool": "open_scene",
    "arguments": {
      "scene_path": "res://scenes/integration/input_acceptance.tscn"
    }
  },
  {
    "server": "godot",
    "tool": "play_scene",
    "arguments": {
      "mode": "current"
    },
    "wait_after": 20
  },
  {
    "server": "godot",
    "tool": "execute_game_script",
    "arguments": {
      "code": "start_enter_checks()"
    },
    "wait_after": 45
  },
  {
    "server": "godot",
    "tool": "execute_game_script",
    "arguments": {
      "code": "get_meta(\"enter_report\")"
    }
  },
  {
    "server": "godot",
    "tool": "get_game_screenshot",
    "arguments": {}
  },
  {
    "server": "godot",
    "tool": "get_editor_errors",
    "arguments": {}
  },
  {
    "server": "godot",
    "tool": "stop_scene",
    "arguments": {}
  }
]