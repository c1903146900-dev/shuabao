  {
    "server": "blender",
    "tool": "execute_blender_code",
    "arguments": {
      "code": "import bpy\nobj = bpy.data.objects.get(\"MCP_AnimationProbe\")\nif obj is None:\n    bpy.ops.mesh.primitive_cube_add(size=2, location=(0,0,0))\n    obj = bpy.context.object\n    obj.name = \"MCP_AnimationProbe\"\nobj.animation_data_clear()\nfor frame, x in [(1,0.0),(12,3.0),(24,0.0)]:\n    obj.location.x = x\n    obj.keyframe_insert(data_path=\"location\", frame=frame)\nbpy.context.scene.frame_end=24\nbpy.context.scene.frame_set(12)\nbpy.ops.wm.save_as_mainfile(filepath='/workspace/shuabao/.local/mcp-fixture/animation_probe.blend')\nprint(\"MCP_BLEND_SAVED\")",
      "user_prompt": "Create only a temporary cube animation for MCP roundtrip acceptance."
    }
  },
  {
    "server": "blender",
    "tool": "execute_blender_code",
    "arguments": {
      "code": "import bpy\nbpy.ops.wm.open_mainfile(filepath='/workspace/shuabao/.local/mcp-fixture/animation_probe.blend')\nprint('MCP_BLEND_REOPENED')"
    },
    "wait_after": 3
  },
  {
    "server": "blender",
    "tool": "execute_blender_code",
    "arguments": {
      "code": "import bpy\nobj=bpy.data.objects[\"MCP_AnimationProbe\"]\naction=obj.animation_data.action\nkeys=[[(p.co.x,p.co.y) for p in f.keyframe_points] for f in action.fcurves if f.data_path==\"location\" and f.array_index==0]\nbpy.context.scene.frame_set(12)\nassert keys == [[(1.0,0.0),(12.0,3.0),(24.0,0.0)]], keys\nassert abs(obj.location.x-3.0)<0.001\nprint({\"MCP_ANIMATION_ROUNDTRIP_OK\":True,\"keyframes_x\":keys,\"frame12_x\":obj.location.x})"
    },
    "expect_text": [
      "MCP_ANIMATION_ROUNDTRIP_OK",
      "'frame12_x': 3.0"
    ]
  },
